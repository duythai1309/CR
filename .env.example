NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Trợ lý ảo. Cấu hình được ngay trên /quan-tri/tro-ly; các biến dưới đây là lớp nền,
# dùng khi chưa lưu gì trong hệ thống. Không có khoá ở đâu cả thì trợ lý tự tắt,
# phần còn lại của nền tảng vẫn chạy bình thường.
GEMINI_API_KEY=
# Bỏ trống để dùng mặc định gemini-2.5-flash.
GEMINI_MODEL=

# Chỉ cần khi muốn LƯU khoá API qua giao diện quản trị: cột chat_settings.api_key
# không cấp quyền đọc cho vai trò ứng dụng nào, nên máy chủ đọc nó bằng service role.
# Bỏ trống thì giao diện vẫn đổi được nhà cung cấp và model, còn khoá lấy từ biến
# môi trường ở trên. TUYỆT ĐỐI không đặt biến này ở phía trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=

# Token để eval platform gọi POST /api/eval/chat. Trống thì endpoint tự tắt (503).
EVAL_API_TOKEN=
